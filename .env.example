# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maps_monitor
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME=Google Maps Monitor
APP_URL=http://localhost
APP_ENV=production
APP_DEBUG=false
TIMEZONE=Europe/Warsaw

# Security
SESSION_LIFETIME=7200
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900

# Scraper Configuration
SCRAPER_PATH=/var/www/html/scraper/scraper.js
NODE_PATH=/usr/bin/node
SCRAPER_TIMEOUT=300
SCRAPER_HEADLESS=true
MAX_RETRIES=3
REQUEST_DELAY_MIN=2000
REQUEST_DELAY_MAX=5000

# Proxy Configuration
PROXY_ROTATION=round-robin
PROXY_HEALTH_CHECK_INTERVAL=3600
PROXY_MAX_FAILED_ATTEMPTS=3
PROXY_TIMEOUT=10000

# Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_ENCRYPTION=tls

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ADMIN_EMAILS=admin@example.com

# Logging
LOG_LEVEL=INFO
LOG_MAX_FILES=90
LOG_COMPRESS_AFTER=7

# Limits
MAX_PHRASES_PER_USER=50
MAX_RESULTS_PER_SCAN=1000
RESULTS_RETENTION_DAYS=180
